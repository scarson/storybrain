    { "slug": "artifacts/the-graft-seed", "type": "artifact", "tension": 0.75, "facts": { "archetype": "graft-seed", "graft_order": 4, "maker": "the-pale-ward", "boon": "your grafts breed true; seed the lineage onward", "edit": "your private memory begins bleeding down the lineage", "history_origin": "grown as the lineage learned to propagate itself" } },
    { "slug": "artifacts/the-whole-mark", "type": "artifact", "tension": 0.9, "facts": { "archetype": "lineage-marker", "graft_order": 5, "maker": "the-canopy-mind", "boon": "completes the set; recognized as one of the Cathedral's own organs", "edit": "the hunter is gone; the Cathedral wears them", "history_origin": "the mark the climax of the history conferred on the first whole host" } },

    { "slug": "lore/fate-of-the-canopy-mind", "type": "lore", "tension": 0.8, "facts": { "subtype": "fragment", "revealed": false, "about": "the-canopy-mind", "text": "the Canopy Mind did not fall when the cascade fired — it communed, folding a human voice into itself for the first time", "from_history": true } },
    { "slug": "lore/fate-of-the-grafted", "type": "lore", "tension": 0.8, "facts": { "subtype": "fragment", "revealed": false, "about": "the-grafted", "text": "the Grafted lineage's long climb through the epochs was the prerequisite chain: each graft made the next survivable", "from_history": true } },
    { "slug": "lore/fate-of-the-pale-ward", "type": "lore", "tension": 0.8, "facts": { "subtype": "fragment", "revealed": false, "about": "the-pale-ward", "text": "the Pale Ward's wars and tests across the history were the gate: no host completed the set until the Ward accepted one", "from_history": true } },
    { "slug": "lore/why-the-cascade-was-communion", "type": "lore", "tension": 0.9, "facts": { "subtype": "fragment", "revealed": false, "text": "the climax the procgen history calls a cascade is the Communion — completion, not collapse; the set finished inside a living host" } },
