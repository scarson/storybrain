    { "slug": "lore/lineage-bleed-note", "type": "lore", "tension": 0.6, "facts": { "text": "after the graft-seed, a colonist recalled a memory three hosts up the chain that was never her own" } },
    { "slug": "lore/node-chorus-note", "type": "lore", "tension": 0.65, "facts": { "text": "with the node grafted, decisions arrived as a chorus; no host could say which thought began in them" } },
