        "kind": "drifting-carrier-hulk",
        "note": "a derelict whose dormant host has begun to stir",
        "live": true
      }
    },
    {
      "slug": "arc/the-containment-race",
      "type": "arc",
      "tension": 0.95,
      "facts": {
        "state": "open",
        "present_stakes": "the carrier on drift-carrier-ninth is stirring and the colony at threshold-landing is inside its range; the makers half-finished seal is the only thing that can hold it",
        "win_condition": "assemble the seal in order (proof -> identify -> trigger -> keystone -> assemble) before a carrier fully wakes, then the sleepers can be woken safely",
        "fail_state": "cracking a relic out of order, or opening a vault before the trigger is read, reseeds the vector inside the colony NOW or wakes the stillborn-host carrier — extinction by the players own hand",
        "clock": "every relic hunted is a turn; the carrier wakes on its own schedule whether or not the seal is ready",
        "note": "a forward containment protocol racing a present sleeping threat, NOT an autopsy of how the makers fell"
      }
    }
