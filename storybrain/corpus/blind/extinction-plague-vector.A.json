    {
      "slug": "lore/proof-the-vector-is-real-and-lethal",
      "type": "lore",
      "tension": 0.85,
      "facts": {
        "subtype": "fragment",
        "revealed": false,
        "step": "0-proof",
        "text": "the makers record proves the extinction-vector is real, self-replicating and lethal — and that they SEALED, they did not die"
      }
    },
    {
      "slug": "lore/identify-the-vectors-nature",
      "type": "lore",
      "tension": 0.85,
      "facts": {
        "subtype": "fragment",
        "revealed": false,
        "step": "1-identify",
        "text": "the assay identifies this world vector as an engineered pathogen that hides in the carriers marrow, so containment must seal bodies, not just patterns"
      }
    },
    {
      "slug": "lore/find-the-dormancy-trigger",
      "type": "lore",
      "tension": 0.85,
      "facts": {
        "subtype": "fragment",
        "revealed": false,
        "step": "2-trigger",
        "text": "the dormancy-trigger reveals exactly what holds the vector asleep — the condition the seal must hold and the mistake that wakes it"
      }
    },
    {
      "slug": "lore/locate-the-keystone-relic",
      "type": "lore",
      "tension": 0.85,
      "facts": {
        "subtype": "fragment",
        "revealed": false,
        "step": "3-keystone",
        "text": "the keystone relic is located, the load-bearing piece the makers seal was built around and abandoned"
      }
    },
    {
      "slug": "lore/assemble-the-seal",
      "type": "lore",
      "tension": 0.85,
      "facts": {
        "subtype": "fragment",
        "revealed": false,
        "step": "4-assemble",
        "text": "with proof, nature, trigger and keystone in hand the seal assembles, finishing the containment the makers never closed"
      }
    },
    {
