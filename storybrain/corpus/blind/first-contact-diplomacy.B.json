{
  "nodes": [
    {
      "slug": "factions/humans",
      "type": "faction",
      "tension": 0.4,
      "facts": {
        "role": "late-arrivals",
        "status": "extant",
        "note": "A multi-ship survey coalition that arrived expecting ruins and found living gatekeepers instead."
      }
    },
    {
      "slug": "civs/the-irenni",
      "type": "faction",
      "tension": 0.6,
      "facts": {
        "alien_type": "living-elder-xeno-persons",
        "trait": "ancient, patient gatekeepers who lend gifts as tests and read every human choice",
        "status": "living",
        "note": "The senior faction. They lend technology one piece at a time and have vetted petitioners for longer than humans have had writing. PRESENT, with agency — not a ruin."
      }
    },
    {
      "slug": "civs/the-saalvane",
      "type": "faction",
      "tension": 0.7,
      "facts": {
        "alien_type": "living-rival-xeno-faction",
        "trait": "a splinter that thinks humanity should be denied, not vetted — they sabotage the gifts",
        "status": "living",
        "note": "A breakaway faction. They argue humanity should be refused outright and corrupt the lent gifts to make humans convict themselves."
      }
    },
    {
      "slug": "civs/the-mendicant-tier",
      "type": "faction",
      "tension": 0.55,
      "facts": {
        "alien_type": "living-xeno-mediators",
        "trait": "a neutral caste that brokers access and adjudicates worthiness disputes",
        "status": "living",
        "note": "The broker caste. They mediate between Irenni, Saalvane, and any petitioner, and hold the keys to dispute resolution."
      }
    },
    {
      "slug": "locations/lattice-fuel-seam",
      "type": "location",
      "tension": 0.435,
      "facts": {
        "resource": "lattice-fuel",
        "danger": 0.45,
        "note": "A contested fuel seam the alien factions tap; humans need it too, which is the moderate resource friction under the diplomacy."
      }
    },
    {
      "slug": "locations/cache-seals-seam",
