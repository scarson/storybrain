      "slug": "locations/the-dark-rings",
      "type": "location",
      "tension": 0.55,
      "facts": {
        "state": "dormant, unpowered nested rings",
        "note": "wake one ring per key"
      }
    },
    {
      "slug": "locations/the-core-vault",
      "type": "location",
      "tension": 0.7,
      "facts": {
        "resource": "core-matter",
        "danger": 0.75,
        "state": "sealed; the most-warded region"
      }
    },
    {
      "slug": "locations/the-empty-cradles",
      "type": "location",
      "tension": 0.6,
      "facts": {
        "note": "habitats sized for the builders, swept clean, no bodies, beds made",
        "state": "dormant"
      }
    },
    {
      "slug": "locations/the-listening-spire",
      "type": "location",
      "tension": 0.5,
      "facts": {
        "note": "an antenna ring the First Listeners woke and then abandoned",
        "state": "half-lit"
      }
    },
    {
      "slug": "locations/the-current-weir",
      "type": "location",
      "tension": 0.55,
      "facts": {
        "resource": "ring-current",
        "danger": 0.5,
        "state": "throttled"
      }
    },
    {
      "slug": "figures/dr-anwen-sole",
      "type": "colonist",
      "tension": 0.5,
      "facts": {
        "role": "lead archaeo-engineer of the Inheritor Fleet",
        "drive": "wants to read the whole sequence before lighting the last key"
      }
    },
    {
      "slug": "figures/quartermaster-vale",
      "type": "colonist",
      "tension": 0.6,
      "facts": {
        "role": "Keybearer quartermaster",
        "drive": "light everything; the power solves the colony's scarcity"
      }
    },
    {
      "slug": "figures/sister-okonkwo",
      "type": "colonist",
      "tension": 0.6,
      "facts": {
        "role": "Warder voice",
        "drive": "the sealed core was sealed last and on purpose"
      }
    },
    {
      "slug": "figures/the-listener-glyph",
      "type": "figure",
      "tension": 0.45,
      "facts": {
        "role": "the First Listeners' parting message, addressed to whoever comes next"
      }
    },
    {
      "slug": "figures/the-last-keeper",
      "type": "figure",
      "tension": 0.5,
      "facts": {
        "role": "the caretaker who wrote the shutdown codex and walked into the dark last"
      }
    },
    {
      "slug": "figures/engineer-tan",
      "type": "colonist",
      "tension": 0.5,
      "facts": {
        "role": "Inheritor Fleet power-systems lead",
        "drive": "map every region's draw before anyone fires the core"
      }
    },
    {
      "slug": "beliefs/the-gift-doctrine",
      "type": "belief",
      "tension": 0.5,
      "facts": {
        "held_by": "the-keybearers",
        "claim": "the builders left the machine on FOR us; finishing it is our inheritance"
      }
    },
    {
      "slug": "beliefs/the-trap-doctrine",
      "type": "belief",
      "tension": 0.55,
      "facts": {
        "held_by": "the-warders",
        "claim": "the dark was made on purpose; the final key is a fuse, not a gift"
      }
    },
    {
      "slug": "curses/the-one-shot",
      "type": "curse",
      "tension": 0.7,
      "facts": {
        "claim": "the departure can fire only once; whoever completes the sequence cannot take it back"
      }
    },
    {
      "slug": "artifacts/the-threshold-key",
      "type": "artifact",
      "tension": 0.6,
      "facts": {
        "archetype": "control-key",
        "wakes": "the-dark-rings",
        "found_in": "the-empty-cradles"
      }
    },
    {
      "slug": "artifacts/the-cradle-sigil",
      "type": "artifact",
      "tension": 0.6,
      "facts": {
        "archetype": "access-sigil",
        "wakes": "the-empty-cradles"
      }
    },
    {
      "slug": "artifacts/the-keepers-codex",
      "type": "artifact",
      "tension": 0.7,
      "facts": {
        "archetype": "activation-codex",
        "note": "the shutdown sequence, read backwards = the build sequence"
      }
    },
    {
      "slug": "artifacts/the-listeners-relay",
      "type": "artifact",
      "tension": 0.6,
      "facts": {
        "archetype": "region-key",
        "wakes": "the-listening-spire"
      }
    },
    {
      "slug": "artifacts/the-core-ward",
      "type": "artifact",
      "tension": 0.8,
      "facts": {
        "archetype": "ward-sigil",
        "guards": "the-core-vault",
        "note": "a key that REFUSES; the only one built to keep a room shut"
      }
    },
    {
      "slug": "artifacts/the-final-fragment",
      "type": "artifact",
      "tension": 0.85,
      "facts": {
        "archetype": "purpose-fragment",
        "note": "the last key; lighting it completes the sequence"
      }
    },
    {
      "slug": "lore/the-shell-was-never-finished-by-accident",
      "type": "lore",
      "tension": 0.7,
      "facts": {
        "subtype": "fragment",
        "revealed": false,
        "claim": "the structure is not a ruin; it was switched OFF in deliberate order, region by region"
      }
    },
    {
      "slug": "lore/the-keepers-sequenced-the-dark",
      "type": "lore",
      "tension": 0.75,
      "facts": {
        "subtype": "fragment",
        "revealed": false,
        "claim": "the caretakers powered down each ring in reverse build-order after the makers were already gone"
      }
    },
    {
      "slug": "lore/the-listeners-heard-the-aim",
      "type": "lore",
      "tension": 0.75,
      "facts": {
        "subtype": "fragment",
        "revealed": false,
        "claim": "the First Listeners woke the spire and learned the structure points OUTWARD — it is an emitter, not a home"
      }
    },
    {
      "slug": "lore/the-purpose-was-a-departure",
      "type": "lore",
      "tension": 0.85,
      "facts": {
        "subtype": "fragment",
        "revealed": false,
        "claim": "the megastructure is a launch instrument; its completed function was to send the builders somewhere the structure could not follow"
      }
    },
    {
      "slug": "lore/the-core-is-the-engine-of-leaving",
      "type": "lore",
      "tension": 0.9,
      "facts": {
        "subtype": "fragment",
        "revealed": false,
        "claim": "the warded core holds the firing matter; completing the sequence aims and fires the departure — once"
      }
    },
    {
      "slug": "lore/shell-lumen-is-free-power",
      "type": "lore",
      "tension": 0.4,
      "facts": {
        "claim": "the lit shell yields effectively unlimited clean power to whoever holds a control-key"
      }
    },
    {
      "slug": "lore/cradles-were-left-tidy",
      "type": "lore",
      "tension": 0.5,
      "facts": {
        "claim": "the builders' habitats were cleaned and closed, not fled — no panic, no bodies"
      }
    },
    {
      "slug": "lore/keepers-left-last",
      "type": "lore",
      "tension": 0.55,
      "facts": {
        "claim": "the caretakers outlived the makers and chose to follow them, leaving the codex for the next inheritor"
      }
    },
    {
      "slug": "lore/relay-still-listens",
      "type": "lore",
      "tension": 0.5,
      "facts": {
        "claim": "the spire still receives a faint return signal from wherever the builders went"
      }
    },
    {
      "slug": "lore/core-matter-is-volatile",
      "type": "lore",
      "tension": 0.6,
      "facts": {
        "claim": "core-matter powers the firing but is single-use and dangerous to wake"
      }
    },
    {
      "slug": "lore/the-ward-is-a-warning",
      "type": "lore",
      "tension": 0.7,
      "facts": {
        "claim": "the core-ward is the only sigil built to deny entry; the builders wanted the last step to require deliberate choice"
      }
    },
    {
      "slug": "arc/finish-it-or-leave-it-dark",
      "type": "arc",
      "tension": 0.9,
      "facts": {
        "state": "open",
        "stakes": "completing the sequence either gifts humanity a star-engine or fires a departure no one can recall",
        "resolution": "undecided"
      }
    }
  ],
