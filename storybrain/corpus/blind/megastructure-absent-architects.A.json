      "facts": {
        "role": "human late-arrivals",
        "status": "exploring",
        "note": "the colony ship Cassava and its descendants, woken inside a working megastructure"
      }
    },
    {
      "slug": "factions/the-keybearers",
      "type": "faction",
      "tension": 0.6,
      "facts": {
        "role": "human salvage guild",
        "creed": "every dark region must be lit",
        "status": "ascendant"
      }
    },
    {
      "slug": "factions/the-warders",
      "type": "faction",
      "tension": 0.65,
      "facts": {
        "role": "human caution-order",
        "creed": "some rooms were sealed for a reason; do not finish what the builders abandoned",
        "status": "growing"
      }
    },
    {
      "slug": "civs/the-architects",
      "type": "faction",
      "tension": 0.5,
      "facts": {
        "alien_type": "absent-builders-no-corpse",
        "trait": "the vanished makers; left a lit machine and no remains, no graves, no war",
        "status": "absent",
        "note": "genuinely other, genuinely gone"
      }
    },
    {
      "slug": "civs/the-keepers",
      "type": "faction",
      "tension": 0.5,
      "facts": {
        "alien_type": "absent-caretaker-order",
        "trait": "successor caretakers who tended and then sequenced the shutdowns before they too departed",
        "status": "absent"
      }
    },
    {
      "slug": "civs/the-first-listeners",
      "type": "faction",
      "tension": 0.45,
      "facts": {
        "alien_type": "absent-inheritor-pilgrims",
        "trait": "an earlier inheritor species that woke pieces, learned part of the purpose, and left without explanation",
        "status": "absent"
      }
    },
    {
      "slug": "locations/the-girdling-shell",
      "type": "location",
