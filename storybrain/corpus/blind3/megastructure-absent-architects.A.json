      "tension": 0.78,
      "facts": {
        "archetype": "purpose-fragment",
        "maker": "the-architects",
        "note": "the makers' own encoded statement of what the shell was built to DO"
      }
    },
    {
      "slug": "artifacts/keepers-ward-sigil-of-the-core",
