{
  "nodes": [
    {
      "slug": "factions/humans",
      "type": "faction",
      "tension": 0.45,
      "facts": {
        "role": "late-arrivals",
        "live_status": "exploring the inhabited machine NOW",
        "note": "the colony fleet limped into the Inheritance and made camp inside a working megastructure whose builders were already gone"
      }
    },
    {
      "slug": "civs/the-architects",
      "type": "faction",
      "tension": 0.6,
      "facts": {
        "alien_type": "absent-builders-no-corpse",
        "trait": "the vanished makers; raised the shell around their star, left no body, no grave, no war-scar",
        "status": "absent",
        "fate": "departed — they finished the structure and went somewhere through it, not down into it"
      }
    },
    {
      "slug": "civs/the-keepers",
      "type": "faction",
      "tension": 0.58,
      "facts": {
        "alien_type": "absent-caretaker-order",
        "trait": "a successor caste who tended the rings after the makers were gone, then darkened the structure in deliberate sequence",
        "status": "absent",
        "fate": "vanished — followed the makers out the same door once the last ring was banked; their quarters left tidy and empty"
      }
    },
    {
      "slug": "civs/the-listeners",
      "type": "faction",
      "tension": 0.57,
      "facts": {
        "alien_type": "absent-inheritor-pilgrims",
        "trait": "an earlier inheritor species that found the dark shell before humans, woke part of it, read part of its aim",
        "status": "absent",
        "fate": "departed — they reached the final key, understood what turning it meant, and chose to leave it unturned and go home"
      }
    },
    {
      "slug": "locations/shell-lumen-seam",
      "type": "location",
      "tension": 0.4,
      "facts": {
        "subject": "shell-lumen",
        "danger": 0.3,
        "live_state": "lit and warm; the outermost ring, free power to whoever holds a key"
      }
    },
    {
      "slug": "locations/ring-current-seam",
      "type": "location",
      "tension": 0.5,
      "facts": {
        "subject": "ring-current",
        "danger": 0.5,
        "live_state": "throttled to a trickle; the mid-rings the Keepers banked last"
      }
    },
    {
      "slug": "locations/core-matter-seam",
      "type": "location",
      "tension": 0.62,
      "facts": {
        "subject": "core-matter",
        "danger": 0.75,
        "live_state": "warded and dark; the firing chamber at the shell's heart, sealed deepest of all"
      }
    },
    {
      "slug": "locations/the-empty-cradles",
      "type": "location",
      "tension": 0.55,
      "facts": {
        "live_state": "swept clean, beds made, no remains; the Architects' own living-quarters",
        "note": "the human survey camp is pitched here, sleeping in the makers' empty rooms"
      }
    },
    {
      "slug": "locations/the-listening-spire",
      "type": "location",
      "tension": 0.52,
      "facts": {
        "live_state": "half-woken by the Listeners; still catching a faint, periodic return-signal from wherever the builders went"
      }
    },
    {
      "slug": "figures/the-keepers-stewardvoice",
      "type": "figure",
      "tension": 0.45,
      "facts": {
        "role": "the Keeper steward whose recorded voice annotates every shutdown step",
        "civ": "the-keepers",
        "note": "a voiceprint in the banking-logs, not a body"
      }
    },
    {
      "slug": "figures/the-listeners-firstear",
      "type": "figure",
      "tension": 0.45,
      "facts": {
        "role": "the Listener who first decoded the structure's outward aim at the spire",
        "civ": "the-listeners"
      }
    },
    {
      "slug": "figures/the-listeners-last-pilgrim",
      "type": "figure",
      "tension": 0.48,
      "facts": {
        "role": "the Listener who held the final access-codex and chose to depart rather than fire the core",
        "civ": "the-listeners"
      }
    },
    {
      "slug": "figures/captain-mara-okonjo",
      "type": "colonist",
      "tension": 0.58,
      "facts": {
        "role": "human expedition captain",
        "species": "human",
        "live": true,
        "drive": "keep the colony alive AND understand what we are standing inside before anyone forces the question",
        "want": "hold the colony together through the vote without it fracturing into a power-grab or a mutiny",
        "skills": {
          "command": 16,
          "navigation": 11,
          "sensors": 9,
          "gunnery": 8,
