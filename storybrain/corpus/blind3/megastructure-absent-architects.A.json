      "tension": 0.7,
      "facts": {
        "archetype": "ward-sigil",
        "maker": "the-keepers",
        "wakes": "core-matter-seam",
        "note": "the Keepers' seal on the firing chamber; lifting it exposes the core"
      }
    },
    {
      "slug": "artifacts/listeners-final-activation-codex",
      "type": "artifact",
      "tension": 0.85,
      "facts": {
        "archetype": "activation-codex",
        "maker": "the-listeners",
        "note": "the Listeners' reconstruction of the full activation order; the last entry is the core",
        "live_risk": "turning the final entry aims and fires the structure a single time"
      }
    },
    {
      "slug": "lore/frag-banked-not-abandoned",
      "type": "lore",
      "tension": 0.72,
      "facts": {
        "subtype": "fragment",
        "revealed": false,
        "claim": "this is not a ruin: the rings were powered DOWN in a deliberate, reversible sequence, not lost in any fall"
      }
    },
    {
      "slug": "lore/frag-keepers-darkened-after-makers-gone",
      "type": "lore",
      "tension": 0.76,
      "facts": {
        "subtype": "fragment",
        "revealed": false,
        "claim": "the Keepers banked the rings AFTER the Architects had already vanished; there was no war and no plague between the two — only inheritance and tidy departure"
      }
    },
    {
      "slug": "lore/frag-the-shell-aims-outward",
      "type": "lore",
      "tension": 0.8,
      "facts": {
        "subtype": "fragment",
        "revealed": false,
        "claim": "the Listeners woke the spire and learned the shell is an EMITTER pointed outward, not a habitat turned inward"
      }
    },
    {
      "slug": "lore/frag-the-purpose-was-departure",
      "type": "lore",
      "tension": 0.85,
      "facts": {
        "subtype": "fragment",
        "revealed": false,
        "claim": "the completed function was a DEPARTURE: the structure was built to send its makers somewhere it could not follow, and they took it"
      }
    },
    {
      "slug": "lore/frag-the-core-fires-once",
      "type": "lore",
      "tension": 0.9,
      "facts": {
        "subtype": "fragment",
        "revealed": false,
        "claim": "the warded core holds the firing-charge; completing the activation order aims and fires that departure exactly once, and cannot be undone"
      }
    },
    {
      "slug": "lore/cradles-left-tidy",
      "type": "lore",
      "tension": 0.5,
      "facts": {
        "claim": "every cradle and Keeper quarter was found swept and made up — these are rooms left on purpose, not rooms fled"
      }
    },
    {
      "slug": "lore/holding-a-key-is-free-power",
      "type": "lore",
      "tension": 0.42,
      "facts": {
        "claim": "holding any region- or control-key grants the colony effectively unlimited shell-power for as long as it is held"
      }
    },
    {
      "slug": "lore/spire-still-receives",
      "type": "lore",
      "tension": 0.56,
      "facts": {
        "claim": "the listening-spire still catches a faint periodic return-signal — proof something is on the far side of wherever the builders went"
      }
    },
    {
      "slug": "lore/core-matter-is-single-use",
      "type": "lore",
      "tension": 0.6,
      "facts": {
        "claim": "core-matter is the firing-charge itself; once spent it cannot be remade with anything left inside the structure"
      }
    },
    {
      "slug": "lore/codex-ends-on-the-core",
      "type": "lore",
      "tension": 0.7,
      "facts": {
        "claim": "the activation codex terminates on the core: every other key is a deliberate step toward turning that final one"
      }
    },
    {
      "slug": "lore/listeners-stopped-at-the-last-key",
      "type": "lore",
      "tension": 0.65,
      "facts": {
        "claim": "the Listeners assembled the full order, reached the final entry, and chose to leave it unturned and go home"
      }
    },
    {
      "slug": "lore/outer-ring-relit-first",
      "type": "lore",
      "tension": 0.4,
      "facts": {
        "claim": "the outer ring is the first banking-step in reverse; relighting it is the safe, free gift, generations before the core ever comes into question"
      }
    },
    {
      "slug": "lore/keeper-echo-still-answers",
      "type": "lore",
      "tension": 0.58,
      "facts": {
        "claim": "a Keeper steward's recorded log-personality still answers from the banking-logs — instructions and accounting, no will of its own, asking only that an inheritor confirm the rings were banked on purpose"
      }
    },
    {
      "slug": "lore/construct-kept-the-lights-on",
      "type": "lore",
      "tension": 0.6,
      "facts": {
        "claim": "a maintenance-construct the Architects left behind kept the structure tended for ages and recites the makers' purpose on request — a left-behind machine that never decided anything itself"
      }
    },
    {
      "slug": "events/discovery",
      "type": "event",
      "tension": 0.45,
      "facts": {
        "title": "the colony wakes its first ring",
        "live": true,
        "note": "humans turn a salvaged region-key and the outer shell lights for the first time in an age"
      }
    },
    {
      "slug": "events/the-completion",
      "type": "event",
      "tension": 0.92,
      "facts": {
        "title": "the shell completed and the makers departed",
        "note": "the finished, reconstructed culmination: the Architects ran the order to its end and were gone, no body left behind"
      }
    },
    {
      "slug": "arc/turn-the-last-key",
      "type": "arc",
      "tension": 0.93,
      "facts": {
        "phase": "rising",
        "live": true,
        "stakes": "completing the activation order either gifts the colony a working star-engine or fires a one-time departure into the dark that nothing can recall",
        "present_tension": "the final codex is already in human hands and the colony is splitting over whether to use it",
        "next_beat_if_pressed": "Rust assembles the order and lifts the core ward; the chamber begins to charge",
        "next_beat_if_held": "Sole publishes the Listeners' refusal and the colony votes to leave the key unturned",
        "resolution": "open"
      }
    }
  ],
