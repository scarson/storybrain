      "facts": {
        "role": "human xeno-archivist",
        "species": "human",
        "live": true,
        "drive": "read the whole purpose-chain before the last key is ever turned; the Listeners walked away for a reason",
        "want": "publish the Listeners' recorded refusal in full so the colony votes to leave the core unturned",
        "skills": {
          "xeno": 18,
