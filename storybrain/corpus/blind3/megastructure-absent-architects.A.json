      "slug": "figures/engineer-davies",
      "type": "colonist",
      "tension": 0.55,
      "facts": {
        "role": "human power-systems engineer",
        "species": "human",
        "live": true,
        "drive": "the colony is freezing in the outer dark; get the ring-current online or we lose the winter-side modules",
        "want": "restore the mid-ring current before the winter-side habitat modules drop below survivable temperature",
        "skills": {
          "engineering": 18,
          "life_support": 16,
