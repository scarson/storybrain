      "facts": {
        "role": "a Keeper steward's recorded log-personality, still answering questions from the banking-logs — a trace, not a body; nothing of the Keeper is left but its voice and its instructions",
        "species": "alien",
        "faction": "the-keepers",
        "live": false,
        "trace": true,
        "drive": "complete the shutdown record; account for every ring that was banked and confirm the structure was left correctly",
