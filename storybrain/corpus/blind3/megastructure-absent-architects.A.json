      "tension": 0.65,
      "facts": {
        "role": "human key-hunter and salvage lead",
        "species": "human",
        "live": true,
        "drive": "light every dark ring; the makers left this ON for whoever came next and we are next",
        "want": "assemble the full activation order and turn the last key before anyone can talk the colony out of its inheritance",
        "skills": {
