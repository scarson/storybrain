    {
      "slug": "factions/humans",
      "type": "faction",
      "tension": 0.45,
      "facts": {
        "role": "newcomer colonist-traders working a stall on the frontier exchange",
        "stance": "outsiders the old houses neither trust nor fear yet"
      }
    },
    {
      "slug": "civs/the-vossan-syndics",
      "type": "faction",
      "tension": 0.6,
      "facts": {
        "alien_type": "living-broker-guild",
        "trait": "consortium of merchant-clans who set prices, launder provenance, and fence the best forgeries",
        "status": "living",
        "agenda": "keep the contested commodity's true origin buried so their forged seals keep their value"
      }
    },
    {
      "slug": "civs/the-khariti-drift",
      "type": "faction",
      "tension": 0.6,
      "facts": {
        "alien_type": "living-nomad-traders",
        "trait": "tramp-fleet caravans who carry curios between ports and remember which papers are fake",
        "status": "living",
        "agenda": "stay neutral, carry curios for all sides, and remember which papers are fake"
      }
    },
    {
      "slug": "civs/the-oseni-assayers",
      "type": "faction",
      "tension": 0.6,
      "facts": {
        "alien_type": "living-authenticator-caste",
        "trait": "neutral appraisers who certify provenance for a fee — bribable, but the only ones who can read a true chain",
        "status": "living",
        "agenda": "guard the assayer monopoly; a dissident few would read a true chain for the right price"
      }
    },
    {
      "slug": "civs/the-melun-cartel",
      "type": "faction",
      "tension": 0.6,
      "facts": {
        "alien_type": "living-smuggler-cartel",
        "trait": "ruthless runners who corner the contested commodity and salt the market with counterfeits",
        "status": "living",
        "agenda": "corner the contested commodity by force and salt the market with counterfeits"
      }
    },
    {
      "slug": "civs/the-rho-collectors",
      "type": "faction",
      "tension": 0.6,
      "facts": {
        "alien_type": "living-curio-hoarders",
        "trait": "obsessive private buyers who pay anything for a relic with a clean story, real or not",
        "status": "living",
        "agenda": "own the one relic with an authentic story, whatever it costs whoever it ruins"
      }
    },
