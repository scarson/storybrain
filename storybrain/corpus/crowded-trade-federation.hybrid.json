    {
      "slug": "arcs/the-provenance-deal",
      "type": "arc",
      "tension": 0.7,
      "facts": {
        "state": "OPEN",
        "desc": "the live, unresolved hunt: authenticate the contested relic by stripping its forged provenance oldest to newest, down to a singular true origin — then decide whether to sell the truth, sell the silence, or set the maker free",
        "stakes": "rival houses are closing in; whoever fixes the chain first sets the price of the whole commodity"
      }
    },
