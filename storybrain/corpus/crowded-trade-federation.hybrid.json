      }
    },
    {
      "slug": "beliefs/provenance-is-power",
      "type": "belief",
      "tension": 0.45,
      "facts": {
        "creed": "a relic is worth its story, not its substance; whoever owns the chain owns the price"
      }
    },
    {
      "slug": "beliefs/the-mined-myth",
      "type": "belief",
      "tension": 0.5,
      "facts": {
        "creed": "the market's shared lie that ghostlight-amber is dug from dead seams — the fiction that hides the living maker being harvested"
      }
    },
    {
      "slug": "artifacts/the-humming-curio",
      "type": "artifact",
      "tension": 0.7,
      "facts": {
        "archetype": "black-market-curio",
        "desc": "the relic at the centre of the deal: a node of ghostlight-amber whose forged papers say 'mined' and whose hum says otherwise"
      }
    },
    {
      "slug": "lore/prov-true-origin-living-maker",
      "type": "lore",
      "tension": 0.6,
      "facts": {
        "subtype": "fragment",
        "revealed": false,
        "claim": "the oldest contraband relic names who first put light into the amber",
        "truth": "ghostlight-amber is not mined at all — it is grown by a quiet living maker-species the market pretends does not exist, so its forgeries keep their price",
        "chain_position": "true-origin"
      }
    },
    {
      "slug": "lore/prov-oseni-authentic-transfer",
      "type": "lore",
      "tension": 0.6,
      "facts": {
        "subtype": "fragment",
        "revealed": false,
        "claim": "an Oseni assayer-seal certifies the oldest authenticated hand-to-hand transfer",
        "truth": "below every forgery sits one genuine provenance link",
        "chain_position": "first-authentic"
      }
    },
    {
      "slug": "lore/prov-melun-smuggled-source",
      "type": "lore",
      "tension": 0.6,
      "facts": {
        "subtype": "fragment",
        "revealed": false,
        "claim": "a Melun broker-token shows the commodity was smuggled from a hidden source, not extracted",
        "truth": "the contested commodity is harvested, not mined — an earlier true link",
        "chain_position": "second"
      }
    },
    {
      "slug": "lore/prov-khariti-carried-it",
      "type": "lore",
      "tension": 0.6,
      "facts": {
        "subtype": "fragment",
        "revealed": false,
        "claim": "a Khariti broker-token records the caravans that actually moved the curio",
        "truth": "strips the Syndic seal: the relic never passed through any mine",
        "chain_position": "third"
      }
    },
    {
      "slug": "lore/prov-forged-mined-origin",
      "type": "lore",
      "tension": 0.6,
      "facts": {
        "subtype": "fragment",
        "revealed": false,
        "claim": "the topmost Syndic provenance-scroll certifies a tidy mined origin",
        "truth": "the newest and most convincing lie, painted over a smuggled, harvested past",
        "chain_position": "newest-lie"
      }
    }
