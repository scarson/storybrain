      "facts": {
        "alien_type": "dormant-self-replicating-plague",
        "trait": "the extinction-agent itself — nanite swarm, mind-virus, or engineered pathogen depending on the world — sleeping in the relics' lore and the carriers' marrow, stirring whenever a seal is broken",
