      "slug": "civs/the-cradlekeepers",
      "type": "faction",
      "tension": 0.55,
      "facts": {
        "alien_type": "dormant-xeno-sleepers",
        "trait": "the makers themselves, sealed in quarantine-sleep behind their own unfinished containment; wakeable as allies — or already carriers, no one knows which vault holds which",
        "status": "extant",
        "wound": 0
      }
    },
    {
      "slug": "civs/the-stillborn-host",
      "type": "faction",
      "tension": 0.55,
      "facts": {
        "alien_type": "dormant-xeno-carriers",
        "trait": "sleepers the vector reached first; dormant carriers whose waking is itself the outbreak, sealed beside the makers they can no longer be told apart from",
        "status": "extant",
        "wound": 0
      }
    },
    {
