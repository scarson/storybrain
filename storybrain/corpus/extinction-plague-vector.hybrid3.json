          "crafting"
        ],
        "want": "to outrun the salt-clock and reach the keystone first, proving speed beats Mara's caution even if it cost him his own blood",
        "skill_profile": "colonist"
      }
    },
    {
      "slug": "colonists/ilse-vantar",
      "type": "colonist",
      "tension": 0.55,
      "facts": {
        "role": "glyph-translator",
        "species": "human",
        "stance": "the only one who can read the cold-glyph, and therefore the most exposed to a vector that travels through meaning",
        "live": true,
        "skills": {
          "research": 18,
          "social": 10,
          "crafting": 8,
          "medicine": 7,
          "shooting": 3,
          "melee": 2
        },
        "passions": [
          "research"
        ],
        "want": "to read the cold-glyph cleanly enough to hold the dormancy condition, without letting its meaning take root in her",
        "skill_profile": "colonist"
      }
    },
    {
      "slug": "colonists/the-archivist-soren",
      "type": "colonist",
      "tension": 0.5,
      "facts": {
        "role": "beacon-archivist",
        "species": "human",
        "stance": "believes a maker can be woken safely as an ally and is quietly preparing to open the host-vault",
        "live": true,
        "skills": {
          "research": 14,
          "social": 15,
          "medicine": 12,
          "crafting": 6,
          "shooting": 4,
          "melee": 3
        },
        "passions": [
          "social",
