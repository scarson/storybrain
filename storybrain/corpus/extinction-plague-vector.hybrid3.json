      "facts": {
        "kind": "human-colony",
        "note": "the colony dome, the nearest unsealed habitat to a stirring carrier",
        "live": true
      }
    },
    {
      "slug": "locations/drift-carrier-ninth",
      "type": "location",
      "tension": 0.75,
      "facts": {
        "kind": "drifting-carrier-hulk",
        "note": "a derelict whose sealed sleeper has begun to stir; its salt is failing on its own schedule",
        "live": true
      }
    },
    {
      "slug": "arc/the-containment-race",
      "type": "arc",
      "tension": 0.95,
      "facts": {
        "phase": "rising",
        "state": "open",
        "present_stakes": "the sleeper on drift-carrier-ninth is stirring as its dormancy-salt fails, and threshold-landing sits inside its range; the makers' half-finished seal is the only thing that can hold it",
        "win_condition": "read the recipe and assemble the seal in order (proof -> identify -> trigger -> keystone -> assemble) before the carrier fully wakes, after which a maker can be woken safely as an ally",
        "fail_state": "cracking a relic out of order or opening the host-vault before the cold-glyph is read reseeds the strain inside the colony NOW or wakes the Stillborn Host carrier; extinction by the colonists' own hand",
        "next_beat_trigger": "Devrant's out-of-order crack of the marrow-assay starts showing in the foam fields, forcing Mara to choose between quarantining him and losing a runner mid-race",
        "next_beat_stakes": "if the cold-glyph is not read before Soren opens the host-vault, the woken sleeper is a carrier and the dome breaches",
        "note": "a forward containment protocol racing a present sleeping threat, not an autopsy of how the makers fell"
      }
    }
  ],
