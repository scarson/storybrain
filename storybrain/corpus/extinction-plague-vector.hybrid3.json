        ],
        "want": "to wake a Cradlekeeper as a living ally who can teach the seal by heart, before the colony has to guess it alone",
        "skill_profile": "colonist"
      }
    },
    {
      "slug": "colonists/halden-ree",
      "type": "colonist",
