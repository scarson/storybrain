      "type": "faction",
      "tension": 0.55,
      "facts": {
        "alien_type": "accountant-subroutine lineage",
        "trait": "branched to audit and reconcile the work against the original order; the project's only memory of intent",
        "status": "fallen",
        "wound": 0
      }
    },
