{
  "nodes": [
    {
      "slug": "factions/humans",
      "type": "faction",
      "tension": 0.45,
      "facts": {
        "role": "newcomers",
        "status": "living",
        "note": "the Drosselmeyer charter, arrived eleven years ago to mine the same dark ore the dead aliens built their empires on, with no idea the ore is nerve-tissue"
      }
    },
    {
      "slug": "civs/the-velt",
      "type": "faction",
      "tension": 0.8,
      "facts": {
        "alien_type": "crystalline-slow-life",
        "trait": "cognition stored in stone, one thought per century",
        "status": "extinct",
        "fate": "vitrified",
        "note": "the slow lithic builders who bored the world's marrow to quicken their hundred-year thoughts; the day the planet woke they flash-froze mid-sentence into clear glass"
      }
    },
    {
      "slug": "civs/the-choir",
      "type": "faction",
      "tension": 0.85,
      "facts": {
        "alien_type": "psychic-gestalt",
        "trait": "a bodiless standing-wave of minds",
        "status": "extinct",
        "fate": "dissolved",
        "note": "a bodiless nation of voices living in the planet's resonance; heard the wound's agony first and threw their whole gestalt against it, and the world learned their frequency and answered in their own voices"
      }
    },
    {
      "slug": "civs/the-pale-wing",
      "type": "faction",
      "tension": 0.78,
      "facts": {
        "alien_type": "augur-merchants",
        "trait": "sold prophecies of the doom instead of preventing it",
        "status": "extinct",
        "fate": "fled-and-lost",
        "note": "winged seer-traders who read the coming catastrophe in the marrow's first tremors and sold tickets to it; their last ships scattered into the void-glass dark and never reported home"
      }
    },
    {
      "slug": "locations/the-marrow-vein",
      "type": "location",
      "tension": 0.9,
      "facts": {
        "resource": "marrow-ore",
        "note": "the deepest extraction shaft, the original wound; still warm, still humming, and the colony's drill is now angled straight at it"
      }
    },
    {
      "slug": "locations/glasshalls-of-velt",
      "type": "location",
      "tension": 0.72,
      "facts": {
        "resource": "void-glass",
        "note": "a Velt city flash-frozen into a single clear block; every street is a hundred-year thought stopped at the comma"
      }
    },
    {
      "slug": "locations/the-silent-amphitheater",
      "type": "location",
      "tension": 0.75,
      "facts": {
        "resource": "lumen-salt",
        "note": "the resonant cavern where the Choir sang itself to death; the lumen-salt walls still hold the last chord like frost"
      }
    },
    {
      "slug": "locations/colony-drosselmeyer",
      "type": "location",
      "tension": 0.5,
      "facts": {
        "kind": "human-colony",
        "note": "the human landing-town, built atop the largest unbroken marrow seam left on the world without anyone reading what lay beneath"
      }
    },
    {
      "slug": "figures/velt-deepwright-kael",
      "type": "figure",
      "tension": 0.65,
      "facts": {
        "role": "Velt mine-architect",
        "note": "designed the first marrow-bores and, too late, the engine meant to silence them; his crystallized body is the deepest readable thing in the vein"
      }
    },
    {
      "slug": "figures/the-last-cantor",
      "type": "figure",
      "tension": 0.7,
      "facts": {
        "role": "final coherent voice of the Choir",
        "note": "the single node of the gestalt that survived long enough to record a warning instead of a song"
      }
    },
    {
      "slug": "events/the-first-bore",
      "type": "event",
      "tension": 0.6,
      "day": 100,
      "facts": {
        "title": "The Velt sink the first marrow-bore",
        "text": "Deepwright Kael's crews cut the first shaft into the dark ore to feed the Velt's slow minds. They believed they were quarrying mineral. They were severing a nerve."
      }
    },
    {
      "slug": "events/the-golden-quickening",
      "type": "event",
      "tension": 0.62,
      "day": 200,
      "facts": {
        "title": "Refined marrow quickens the Velt into a golden age",
        "text": "Marrow let a Velt think in days instead of decades. Cities bloomed across the world in a single human lifetime, every one of them sited atop a seam to stay close to the supply."
      }
    },
    {
      "slug": "events/the-wound-begins-to-sing",
      "type": "event",
      "tension": 0.72,
      "day": 300,
      "facts": {
        "title": "The severed marrow discharges its agony",
        "text": "Every bore-shaft had cut living tissue, and the world did not die but woke in pieces and in pain. The Choir, who lived in the planet's resonance, heard the wound first and could not stop hearing it."
      }
    },
    {
      "slug": "events/the-pale-wing-sells-the-doom",
      "type": "event",
      "tension": 0.7,
      "day": 400,
      "facts": {
        "title": "The Pale Wing sell prophecies of the end instead of stopping it",
        "text": "The augur-merchants read the catastrophe coming in the marrow's tremors and made a market of it, selling escape-prophecies and salvage-rights to the very civilizations that were dying. They warned everyone and saved no one, least of all themselves."
      }
    },
    {
      "slug": "events/the-choir-sings-it-down",
      "type": "event",
      "tension": 0.82,
      "day": 600,
      "facts": {
        "title": "The Choir throws its whole gestalt against the wound",
        "text": "The Choir sang a counter-wave to lull the planet back to sleep. Instead the planet learned the Choir's frequency by listening, and began to answer in their own borrowed voices."
      }
    },
    {
      "slug": "events/the-waking-of-the-wounded-world",
      "type": "event",
      "tension": 0.97,
      "day": 700,
      "facts": {
        "title": "The wounded world wakes whole and the psychic cascade takes the sky",
        "text": "The amplified agony reached every marrow seam under every city in a single instant. The Velt, tuned to stone, vitrified mid-thought; the Choir dissolved into the song they could no longer leave; the Pale Wing fled into the dark and were never heard again. This is the moment the whole world turns on, the day the planet-mind woke in agony and the three empires ended at once.",
        "is_pivot": true
      }
    },
    {
