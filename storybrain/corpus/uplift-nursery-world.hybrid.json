    {
      "slug": "arc/are-we-the-harvest",
      "type": "arc",
      "tension": 0.85,
      "facts": {
        "state": "OPEN",
        "present_stakes": "every shaping-tool used reveals one more step of the gardeners' method AND draws their attention; the colony is mid-cultivation and does not yet know toward what",
        "resolves_when": "the reveals-chain completes — but the harvest itself is still ahead, unwitnessed",
        "tense": "present"
      }
    },
    {
      "slug": "powers/sense-the-aimedness",
      "type": "power",
      "tension": 0.5,
      "facts": {
        "register": "subtle",
        "effect": "a sensing-one feels when a place is too AIMED, and feels the pressure of attention when a tool is used — never sees the gardener",
        "note": "not precognition, not ancestral memory — just the felt geometry of intent"
      }
    },
    {
      "slug": "beliefs/the-patient-hand",
      "type": "belief",
      "tension": 0.45,
      "facts": {
        "tenet": "the world is tended; convenience is a tell; gratitude is the safe posture and greed rings the bell"
      }
    },
    {
      "slug": "locations/the-too-green-valley",
      "type": "location",
      "tension": 0.55,
      "facts": {
        "note": "soil self-enriches overnight; blights answered before noon — the most AIMED place on the planet, where the colony farms and the gardeners watch closest"
      }
    },
    {
      "slug": "lore/method-1-the-seeding",
      "type": "lore",
      "tension": 0.8,
      "facts": {
        "subtype": "fragment",
        "revealed": false,
        "text": "STEP 1 of the gardeners' method: this world was SEEDED, not found — every convenient trait was placed. The aimed-ness is design, not luck.",
        "about": "the-gardeners",
        "step": 1
      }
    },
    {
      "slug": "lore/method-2-the-precedent",
      "type": "lore",
      "tension": 0.8,
      "facts": {
        "subtype": "fragment",
        "revealed": false,
        "text": "STEP 2: a lineage was grown to sapience here before us — the first-cultivars — by the same hand. We are not the first crop in this soil.",
        "about": "the-first-cultivars",
        "step": 2
      }
    },
    {
      "slug": "lore/method-3-the-attention",
      "type": "lore",
      "tension": 0.8,
      "facts": {
        "subtype": "fragment",
        "revealed": false,
        "text": "STEP 3: the tools are not gifts but instruments — using one is the gardeners reading us, scoring how we tend versus how we strip. The bell is a test.",
        "about": "the-loam-tenders",
        "step": 3
      }
    },
    {
      "slug": "lore/method-4-the-shaping",
      "type": "lore",
      "tension": 0.8,
      "facts": {
        "subtype": "fragment",
        "revealed": false,
        "text": "STEP 4: the gene-looms are already editing the colony's own line — slowly, toward a shape we did not choose. We are mid-cultivation. We ARE the experiment.",
        "about": "the-gardeners",
        "step": 4
      }
    },
    {
      "slug": "lore/method-5-the-harvest-ahead",
      "type": "lore",
      "tension": 0.8,
      "facts": {
        "subtype": "fragment",
        "revealed": false,
        "text": "STEP 5 (still unfolding): the chain points FORWARD — to a harvest the gardeners are patiently waiting for. What we are being grown INTO is in our future, not their past.",
        "about": "the-gardeners",
        "step": 5
      }
    },
    {
      "slug": "events/the-harvest-ahead",
      "type": "event",
      "tension": 0.95,
      "facts": {
        "kind": "climax",
        "title": "the harvest the gardeners are waiting for",
        "state": "still unfolding — not a fall, a culmination ahead"
      }
    },
